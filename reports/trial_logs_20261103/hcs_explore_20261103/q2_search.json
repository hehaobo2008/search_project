      {
        "rank": 4,
        "article_id": "rail_quality:art-25",
        "article_no": "第二十五条",
        "doc_id": "rail_quality",
        "doc_title": "铁路建设工程质量监督管理规定",
        "version_id": "amended_2021_12_23",
        "text": "第二十五条 勘察、设计单位应参与铁路建设工程质量事故分析，提出相应的技术处理方案，并对因勘察设计造成的质量事故承担相应的质量责任。",
        "chars": 65,
