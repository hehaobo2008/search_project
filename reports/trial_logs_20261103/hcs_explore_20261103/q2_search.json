        "source_url": "https://xxgk.mot.gov.cn/2020/jigou/fgs/202202/t20220225_3643089.html",
        "source_sha256": "12bc988c96c3d7595223a938cbe70042369a524c1780de8a59ca028acf4c713d",
        "locator_route": "/locator/rail_quality#art-25",
        "pdf_route": "/pdf/rail_quality#page=7",
